# Local fixed game-server image (ARM64): upstream + our entrypoints.
ARG BASE_IMAGE=ghcr.io/joyfui/project-zomboid-server-docker-arm64:latest
FROM ${BASE_IMAGE}

COPY entrypoint.sh /home/steam/entrypoint.sh
COPY configure-server.sh /home/steam/configure-server.sh
COPY fix-heap.sh /home/steam/fix-heap.sh

USER root
RUN chmod +x /home/steam/entrypoint.sh \
              /home/steam/configure-server.sh \
              /home/steam/fix-heap.sh 2>/dev/null || true \
    && mkdir -p /home/steam/Zomboid/mods /home/steam/Zomboid/Lua/inventory

COPY mods/KnoxRelay /home/steam/Zomboid/mods/KnoxRelay

ENTRYPOINT ["/bin/bash", "/home/steam/entrypoint.sh"]
