# Local fixed game-server image: upstream SteamCMD dedicated server + our entrypoints.
# Compose builds this instead of running the raw pulled image alone.
#
#   docker compose -f docker-compose.yml -f docker-compose.amd64.yml build game-server
#
ARG BASE_IMAGE=renegademaster/zomboid-dedicated-server:latest
FROM ${BASE_IMAGE}

# Our wrappers (heap unit fix, configure-server, branch override)
COPY amd64-entrypoint.sh /home/steam/amd64-entrypoint.sh
COPY configure-server.sh /home/steam/configure-server.sh
COPY fix-heap.sh /home/steam/fix-heap.sh

USER root
RUN chmod +x /home/steam/amd64-entrypoint.sh \
              /home/steam/configure-server.sh \
              /home/steam/fix-heap.sh \
    && mkdir -p /home/steam/Zomboid/mods /home/steam/Zomboid/Lua/inventory

# ZomboidManager is still bind-mounted at runtime for easy Lua updates, but we
# also seed a copy into the image so the stack works without the mount.
COPY mods/ZomboidManager /home/steam/Zomboid/mods/ZomboidManager

ENTRYPOINT ["/bin/bash", "/home/steam/amd64-entrypoint.sh"]
