# =============================================================================
# PZ Server Manager — Production Environment (Docker Compose)
# =============================================================================
# Filled automatically by: .\deploy.ps1  |  ./deploy.sh  |  make init
# SECURITY: Never commit .env to version control.
# =============================================================================

# ── Game Server ─────────────────────────────────────────────────────────────
PZ_SERVER_NAME=ZomboidServer
PZ_ADMIN_USERNAME=admin
PZ_ADMIN_PASSWORD=
PZ_SERVER_PASSWORD=
PZ_MAX_PLAYERS=16
PZ_MAX_RAM=8192m
PZ_GAME_PORT=16261
PZ_DIRECT_PORT=16262
PZ_RCON_PORT=27015
PZ_RCON_PASSWORD=
# public = B42 Stable | unstable = B42 Unstable | legacy41 = B41
PZ_STEAM_BRANCH=public
PZ_MAP_NAMES="Muldraugh, KY"
PZ_MOD_IDS=KnoxRelay
PZ_WORKSHOP_IDS=3777446787
# Steam Workshop ID of the Knox Relay bridge mod.
PZ_BRIDGE_WORKSHOP_ID=3777446787
PZ_PAUSE_ON_EMPTY=true
PZ_PUBLIC_SERVER=true
PZ_STEAM_VAC=true
PZ_AUTOSAVE_INTERVAL=15
PZ_OPEN=true
PZ_AUTO_CREATE_WHITELIST=true
PZ_GC_CONFIG=ZGC
TZ=UTC

# ── Laravel App ─────────────────────────────────────────────────────────────
APP_NAME="PZ Server Manager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost

# ── Web edge (local | caddy | npm) ───────────────────────────────────────
# npm = Nginx Proxy Manager on proxy-network (recommended if :80 is taken)
WEB_PROXY_MODE=npm
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ── Database ────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=zomboid
DB_USERNAME=zomboid
DB_PASSWORD=

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── API ─────────────────────────────────────────────────────────────────────
API_KEY=

# ── Docker ──────────────────────────────────────────────────────────────────
GAME_SERVER_CONTAINER_NAME=pz-game-server
DOCKER_PROXY_URL=http://docker-socket-proxy:2375

ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Queue / Cache / Session ────────────────────────────────────────────────
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# ── Paths ───────────────────────────────────────────────────────────────────
# Paths inside containers (usually leave as-is)
PZ_DATA_PATH=/pz-data
BACKUP_PATH=/backups

# Host bind mounts (relative to docker-compose.yml) — all stack data under ./data/
# `make init` rewrites these to absolute paths so the panel can spawn map-tiles jobs.
PZ_DATA_HOST=./data/zomboid
PZ_SERVER_HOST=./data/server
PZ_BACKUPS_HOST=./data/backups
PZ_MAP_TILES_HOST=./data/map-tiles
# Texture packs for regional isometric rerenders (`make map-tiles-region`).
# Copy a PZ client's media/texturepacks (~527 MB) into this folder.
PZ_TEXTUREPACKS_HOST=./data/server/media/texturepacks
PZ_POSTGRES_HOST=./data/postgres
PZ_REDIS_HOST=./data/redis
PZ_CADDY_DATA_HOST=./data/caddy-data
PZ_CADDY_CONFIG_HOST=./data/caddy-config

# ── Backup Retention ───────────────────────────────────────────────────────
BACKUP_RETENTION_MANUAL=10
BACKUP_RETENTION_SCHEDULED=24
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_PRE_ROLLBACK=5
BACKUP_RETENTION_PRE_UPDATE=3
