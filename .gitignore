# Environment
.env
.env.*
!.env.example
!.env.production.example
.credentials.json
.firewall.conf
ACCESS.local.txt
*.local.txt

# PHP / Composer
*.cache

# Laravel panel (parked; live UI is web/). Local leftovers only.
/app/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Caddy (generated by setup.sh)
caddy/Caddyfile
caddy/certs/

# Database backups (local)
db-backups/

# Game server data (generated at runtime)
game-server/data/
backups/*.tar.gz

# Host-mapped PZ data (bind mounts — do not commit worlds/binaries)
/data/**
!/data/**/.gitkeep

# Those dirs must look *empty* to the container on first boot:
#   - postgres: initdb refuses to initialize a PGDATA that contains any file,
#     including dot-prefixed ones, and the db container ends up in a restart loop.
# The Makefile's `ensure-data-dirs` target creates all of them via `mkdir -p`.

# Node (frontend - future)
node_modules/

# Second web stack (web/) build output
/web/api/target/
/web/ui/dist/

# Workshop build artifacts
workshop/KnoxRelay/Contents/mods/KnoxRelay/42/media/

# Test / Coverage
.playwright-mcp/

# Python bytecode from the map-tiles tooling's tests.
# (.pytest_cache ignores itself via the .gitignore pytest writes inside it.)
__pycache__/
