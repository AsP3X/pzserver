# pz-api configuration.
#
# In Docker these come from docker-compose.web.yml and the root .env; this file
# is for running `cargo run` on the host. Copy it to web/api/.env.

# --- HTTP ---------------------------------------------------------------------
API_BIND=127.0.0.1:8080
# Comma-separated allowlist. The Vite dev server is the only origin in dev.
WEB_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
RUST_LOG=pz_api=debug,tower_http=info,warn

# --- Database -----------------------------------------------------------------
# Host dev: the port docker-compose.web-dev.yml publishes web-db on.
DATABASE_URL=postgres://knox:knox@127.0.0.1:55433/knox
DATABASE_MAX_CONNECTIONS=10

# --- Game server --------------------------------------------------------------
# Reachable from the host only while the game container publishes RCON, which it
# does not by design — expect "rcon unavailable" in host dev, and an offline or
# starting status. That path is exercised properly inside Docker.
PZ_RCON_HOST=127.0.0.1
PZ_RCON_PORT=27015
PZ_RCON_PASSWORD=
PZ_RCON_TIMEOUT=5

DOCKER_PROXY_URL=http://127.0.0.1:2375
GAME_SERVER_CONTAINER_NAME=pz-game-server

# Where the game writes. On the host these are the repo's bind-mount sources.
PZ_DATA_PATH=../../data/zomboid
# Steam Workshop cache (mod.info + appworkshop_108600.acf). Unset hides versions.
PZ_WORKSHOP_PATH=../../data/server/steamapps/workshop
PZ_SERVER_NAME=ZomboidServer
# Host path of Zomboid/ — must be absolute for API-spawned tile jobs.
# PZ_DATA_HOST=
# PZ_SAVE_GAME=Multiplayer/ZomboidServer
# MAP_TILES_WORLD_SCAN_SECS=120
# MAP_TILES_WORLD_MAX_CELLS=8
# Defaults to $PZ_DATA_PATH/Lua and $PZ_DATA_PATH/Server/$PZ_SERVER_NAME.ini.
# LUA_BRIDGE_PATH=
# PZ_SERVER_INI_PATH=

# --- Public connection details ------------------------------------------------
# Shown on the landing page. Unset hides the connect panel entirely.
PZ_CONNECT_HOST=
PZ_GAME_PORT=16261

# --- Accounts -----------------------------------------------------------------
# Created on boot only when no administrator exists yet. Never used to reset a
# password: once an admin is in the table, this is ignored.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Secure cookies work over http://localhost, so this can stay on in dev.
# MUST be true behind HTTPS. Set false only when serving over plain http:
# Safari drops a Secure cookie over http even on localhost, which looks like
# being logged out immediately after a successful login.
SESSION_COOKIE_SECURE=true
# Failed logins allowed per username inside the window.
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=900

# --- Polling ------------------------------------------------------------------
# Status is resolved at most once per TTL no matter how many visitors poll.
STATUS_CACHE_TTL=5
STATUS_SAMPLE_INTERVAL=300
STATS_SYNC_INTERVAL=30
BRIDGE_STALE_AFTER=120
