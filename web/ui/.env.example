# Vite build-time configuration. Copy to web/ui/.env to override.
#
# Only VITE_-prefixed variables reach the browser bundle, so nothing secret
# belongs in this file.

# Leave empty for same-origin requests, which is what both the dev proxy and the
# production nginx front provide. Set it only to point the UI at an API on
# another host, e.g. https://api.example.com
VITE_API_BASE_URL=

# Where `npm run dev` proxies /api to. Build-time only, never shipped.
API_ORIGIN=http://127.0.0.1:8080
