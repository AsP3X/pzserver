# =============================================================================
# PZ Server Manager — Environment Template
# =============================================================================
# One-command deploy (Windows):  .\deploy.ps1
# One-command deploy (Linux):    ./deploy.sh
# Or interactive setup:          .\make.ps1 init   /   make init
#
# Copy is automatic during deploy. SECURITY: never commit a filled .env.
# Deep sandbox / server.ini options are edited in the web UI after first boot.
# =============================================================================

# ── Game Server (bootstrap) ──────────────────────────────────────────────────
# Display name / save profile name (creates Server/<name>.ini on first boot)
PZ_SERVER_NAME=ZomboidServer

# In-game admin account created by the dedicated server
PZ_ADMIN_USERNAME=admin
PZ_ADMIN_PASSWORD=

# Leave empty for an open server; set to require a join password
PZ_SERVER_PASSWORD=

# Concurrent players (also editable later in the web UI)
PZ_MAX_PLAYERS=16

# JVM heap for the game process (e.g. 4096m, 8g). Recommend ≥8g for 8+ players
PZ_MAX_RAM=4096m

# Game + RCON networking
PZ_GAME_PORT=16261
PZ_DIRECT_PORT=16262
PZ_RCON_PORT=27015
PZ_RCON_PASSWORD=

# Steam branch for SteamCMD install:
#   public    = Build 42 Stable (default, recommended)
#   unstable  = Build 42 Unstable (bleeding edge)
#   legacy41  = Build 41.78.x (ZomboidManager dashboard mod will NOT work)
PZ_STEAM_BRANCH=public

# Map / mods (semicolon-separated Workshop IDs and Mod IDs)
# Example: PZ_WORKSHOP_IDS=123456789;987654321  PZ_MOD_IDS=SomeMod;OtherMod
PZ_MAP_NAMES="Muldraugh, KY"
PZ_MOD_IDS=
PZ_WORKSHOP_IDS=

# Server behaviour toggles (also available in web UI after first boot)
PZ_PAUSE_ON_EMPTY=true
PZ_PUBLIC_SERVER=true
PZ_STEAM_VAC=true
PZ_AUTOSAVE_INTERVAL=15
PZ_OPEN=true
PZ_AUTO_CREATE_WHITELIST=true

# Java GC: ZGC is a good default on modern hosts
PZ_GC_CONFIG=ZGC

# Host timezone used by containers (auto-restart schedules, logs)
TZ=UTC

# ── Web Panel (Laravel app) ──────────────────────────────────────────────────
APP_NAME="PZ Server Manager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Public URL for links/cookies. Local deploy uses http://localhost:8000
APP_URL=http://localhost:8000
APP_PORT=8000

# How the web panel is exposed:
#   local — only http://127.0.0.1:APP_PORT (default; no host :80/:443)
#   caddy — built-in Caddy binds CADDY_HTTP_PORT / CADDY_HTTPS_PORT on the host
#   npm   — Nginx Proxy Manager (or similar) on proxy-network; forward to pz-app:8000
WEB_PROXY_MODE=local

# Caddy host ports (only used when WEB_PROXY_MODE=caddy)
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=zomboid
DB_USERNAME=zomboid
DB_PASSWORD=

# ── Redis (queue / cache / sessions) ─────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# API key for REST endpoints (X-API-Key). Auto-generated on deploy
API_KEY=

# Docker integration (do not change unless you rename the game container)
GAME_SERVER_CONTAINER_NAME=pz-game-server
DOCKER_PROXY_URL=http://docker-socket-proxy:2375

# Web panel admin (created on first boot). Separate from in-game PZ admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# Paths inside containers (usually leave as-is)
PZ_DATA_PATH=/pz-data
BACKUP_PATH=/backups

# Host bind mounts for game data (relative to docker-compose.yml)
# Override to put data on another disk, e.g. PZ_DATA_HOST=/mnt/nvme/pz/zomboid
PZ_DATA_HOST=./data/zomboid
PZ_SERVER_HOST=./data/server
PZ_BACKUPS_HOST=./data/backups
PZ_MAP_TILES_HOST=./data/map-tiles

# Backup retention counts
BACKUP_RETENTION_MANUAL=10
BACKUP_RETENTION_SCHEDULED=24
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_PRE_ROLLBACK=5
BACKUP_RETENTION_PRE_UPDATE=3
